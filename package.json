{
  "name": "status-erp",
  "productName": "STATUS ERP IMOBILIÁRIO",
  "version": "0.2.0",
  "description": "Sistema de gestão administrativa, comercial e financeira — Status Negócios Imobiliários",
  "author": "Status Negócios Imobiliários",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/electron-node.mjs node_modules/vitest/vitest.mjs",
    "db:generate": "drizzle-kit generate",
    "rebuild:native": "electron-builder install-app-deps",
    "dist:win": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.104.5",
    "better-sqlite3": "npm:better-sqlite3-multiple-ciphers@^13.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
