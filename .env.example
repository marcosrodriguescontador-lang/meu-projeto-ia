# Copie este arquivo para ".env" (na mesma pasta do sistema) e ajuste os valores.
# Linhas que começam com # são apenas comentários.

# Porta em que o sistema atende. Os computadores da rede acessam http://IP-DO-SERVIDOR:PORTA
PORT=3000

# Segredo que protege as sessões (login). Se ficar vazio, o sistema cria um sozinho
# na primeira execução e guarda em data/session_secret. Não compartilhe.
SESSION_SECRET=

# --- E-mail (código de "Esqueci minha senha") -------------------------------
# Sem SMTP_HOST, o código aparece só na janela (terminal) do servidor.
# Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   SMTP_PASS deve ser uma "senha de app" (Conta Google > Segurança > Senhas de app).
# Outlook/Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
# Hospedagem própria (ex.: Locaweb, HostGator): use os dados de SMTP do provedor (porta 587 ou 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AGRO S <naoresponda@suaempresa.com.br>"

# --- HTTPS opcional, com certificado próprio --------------------------------
# Informe os arquivos do certificado e da chave para ligar também o endereço https.
# HTTPS_CERT_FILE=certificados/agros.pem
# HTTPS_KEY_FILE=certificados/agros-key.pem
# HTTPS_PORT=3443

# --- Avançado ---------------------------------------------------------------
# Caminho do banco de dados (padrão: data/agrocontrol.db)
# DB_PATH=
# Pasta dos backups (padrão: backup/) e quantos manter (padrão: 30)
# BACKUP_DIR=
# BACKUP_MANTER=30
