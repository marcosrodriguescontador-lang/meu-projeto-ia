# Copie este arquivo para ".env" e ajuste os valores.

# Porta em que o sistema atende (padrão 3000).
PORT=3000

# Segredo usado para proteger as sessões. Se ficar vazio, o sistema gera um
# automaticamente na primeira execução e guarda em data/session_secret.
SESSION_SECRET=

# E-mail (SMTP) para enviar o código de "Esqueci minha senha".
# Sem SMTP_HOST, o código aparece apenas no console (terminal) do servidor.
# Exemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=conta@gmail.com,
# SMTP_PASS=senha de app (não a senha normal), SMTP_FROM="AGRO S <conta@gmail.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
